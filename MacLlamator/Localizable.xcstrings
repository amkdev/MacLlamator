          "stringUnit": {
            "state": "translated",
            "value": "Modell"
          }
        }
      }
    },
    "No model": {
      "comment": "Toolbar label while no model is selected",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Modell"
          }
        }
      }
    },
    "No model selected": {
      "comment": "Placeholder in the model picker when nothing is chosen yet",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Modell ausgewählt"
          }
        }
      }
    },
    "No model selected.": {
      "comment": "Error shown when a translation is attempted without a model",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Modell ausgewählt."
          }
        }
      }
    },
    "No models found": {
      "comment": "Shown in the toolbar's model menu when the server offers none",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Modelle gefunden"
          }
        }
      }
    },
    "Ollama": {
      "comment": "Settings tab: server and model",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama"
          }
        }
      }
    },
    "Ollama Server": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama-Server"
          }
        }
      }
    },
    "Ollama unloads a model after five minutes by default, and the next translation then waits for it to be reloaded. A longer setting keeps it resident at the cost of the memory it occupies.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama entlädt ein Modell standardmäßig nach fünf Minuten; die nächste Übersetzung wartet dann auf das erneute Laden. Ein höherer Wert hält es im Speicher — zum Preis des belegten Arbeitsspeichers."
          }
        }
      }
    },
    "Port": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Port"
          }
        }
      }
    },
    "Preferred languages": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevorzugte Sprachen"
          }
        }
      }
    },
    "Prompt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompt"
          }
        }
      }
    },
    "Refresh models": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelle aktualisieren"
          }
        }
      }
    },
    "Reset": {
      "comment": "Clears the custom prompt instructions",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurücksetzen"
          }
        }
      }
    },
    "Server responded with status %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server antwortete mit Status %lld."
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen"
          }
        }
      }
    },
    "Smaller": {
      "comment": "Decreases the text size in both panes",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleiner"
          }
        }
      }
    },
    "Swap languages": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachen tauschen"
          }
        }
      }
    },
    "The model returned the text untranslated — try a shorter passage or another model.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell hat den Text unübersetzt zurückgegeben — versuche einen kürzeren Abschnitt oder ein anderes Modell."
          }
        }
      }
    },
    "The server's response could not be read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwort des Servers konnte nicht gelesen werden."
          }
        }
      }
    },
    "Translation": {
      "comment": "Two uses, same word: the placeholder of the read-only result pane, and the title of the Settings tab holding the translation options.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzung"
          }
        }
      }
    },
    "Until Ollama quits": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis Ollama beendet wird"
          }
        }
      }
    },
    "When automatic detection recognizes one of these two languages, the other is selected as the target language.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkennt die automatische Spracherkennung eine dieser beiden Sprachen, wird jeweils die andere als Zielsprache gewählt."
          }
        }
      }
    }
  },
  "version": "1.0"
}
