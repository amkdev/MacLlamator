{
  "sourceLanguage": "en",
  "strings": {
    "%@ (detected)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (erkannt)"
          }
        }
      }
    },
    "1 hour": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Stunde"
          }
        }
      }
    },
    "30 minutes": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "30 Minuten"
          }
        }
      }
    },
    "5 minutes": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "5 Minuten"
          }
        }
      }
    },
    "Active model": {
      "comment": "Tooltip of the toolbar's model menu",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktives Modell"
          }
        }
      }
    },
    "Additional instructions for the model (optional), e.g. about tone or terminology.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusätzliche Anweisungen an das Modell (optional), z. B. zu Tonalität oder Terminologie."
          }
        }
      }
    },
    "After %@": {
      "comment": "Delay option; %@ is a formatted duration such as 500 ms or 2 s",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach %@"
          }
        }
      }
    },
    "All": {
      "comment": "Button: enable every language",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle"
          }
        }
      }
    },
    "Automatic translation while typing": {
      "comment": "Settings section title",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisches Übersetzen bei Eingabe"
          }
        }
      }
    },
    "Available languages": {
      "comment": "Settings section title on the Languages tab",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfügbare Sprachen"
          }
        }
      }
    },
    "Clear text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text löschen"
          }
        }
      }
    },
    "Copy to clipboard": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Zwischenablage kopieren"
          }
        }
      }
    },
    "Detect language": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch erkennen"
          }
        }
      }
    },
    "Enter text…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text eingeben…"
          }
        }
      }
    },
    "Font": {
      "comment": "Menu bar menu holding the text size commands",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrift"
          }
        }
      }
    },
    "Host or IP address": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Host oder IP-Adresse"
          }
        }
      }
    },
    "How long the text has to stay unchanged before it is translated automatically. Switched off, nothing is sent until Cmd+Return asks for it.": {
      "comment": "Explains the automatic translation setting",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange der Text unverändert bleiben muss, bevor automatisch übersetzt wird. Ausgeschaltet wird nichts gesendet, bis Cmd+Return es verlangt."
          }
        }
      }
    },
    "Invalid server address.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültige Server-Adresse."
          }
        }
      }
    },
    "Keep model in memory": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell im Speicher halten"
          }
        }
      }
    },
    "Language 1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprache 1"
          }
        }
      }
    },
    "Language 2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprache 2"
          }
        }
      }
    },
    "Languages": {
      "comment": "Settings tab title",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachen"
          }
        }
      }
    },
    "Larger": {
      "comment": "Increases the text size in both panes",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größer"
          }
        }
      }
    },
    "Local server (127.0.0.1)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokaler Server (127.0.0.1)"
          }
        }
      }
    },
    "Model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell"
          }
        }
      }
    },
    "No model": {
      "comment": "Toolbar label while no model is selected",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Modell"
          }
        }
      }
    },
    "No model selected": {
      "comment": "Placeholder in the model picker when nothing is chosen yet",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Modell ausgewählt"
          }
        }
      }
    },
    "No model selected.": {
      "comment": "Error shown when a translation is attempted without a model",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Modell ausgewählt."
          }
        }
      }
    },
    "No models found": {
      "comment": "Shown in the toolbar's model menu when the server offers none",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Modelle gefunden"
          }
        }
      }
    },
    "Not among the languages this model lists": {
      "comment": "Tooltip of the hint marker in the language list",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht unter den Sprachen, die dieses Modell nennt"
          }
        }
      }
    },
    "Off — only on Cmd+Return": {
      "comment": "Delay option that switches automatic translation off",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus — nur mit Cmd+Return"
          }
        }
      }
    },
    "Ollama": {
      "comment": "Settings tab: server and model",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama"
          }
        }
      }
    },
    "Ollama Server": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama-Server"
          }
        }
      }
    },
    "Ollama unloads a model after five minutes by default, and the next translation then waits for it to be reloaded. A longer setting keeps it resident at the cost of the memory it occupies.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama entlädt ein Modell standardmäßig nach fünf Minuten; die nächste Übersetzung wartet dann auf das erneute Laden. Ein höherer Wert hält es im Speicher — zum Preis des belegten Arbeitsspeichers."
          }
        }
      }
    },
    "Only the ticked languages appear in the pickers. Which ones are worth offering depends on the model and on what you actually translate — both of which you know better than the app does.": {
      "comment": "Explains the language shortlist",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Auswahlmenüs erscheinen nur die angehakten Sprachen. Welche sich lohnen, hängt vom Modell und davon ab, was tatsächlich übersetzt wird — beides wissen Sie besser als die App."
          }
        }
      }
    },
    "Only what %@ lists": {
      "comment": "Button: reduce the list to what the named model declares; %@ is the model name",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur was %@ nennt"
          }
        }
      }
    },
    "Port": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Port"
          }
        }
      }
    },
    "Preferred languages": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevorzugte Sprachen"
          }
        }
      }
    },
    "Preferred pair only": {
      "comment": "Button: reduce the list to the two preferred languages",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur das Vorzugspaar"
          }
        }
      }
    },
    "Prompt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompt"
          }
        }
      }
    },
    "Refresh models": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelle aktualisieren"
          }
        }
      }
    },
    "Reset": {
      "comment": "Clears the custom prompt instructions",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurücksetzen"
          }
        }
      }
    },
    "Server responded with status %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server antwortete mit Status %lld."
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen"
          }
        }
      }
    },
    "Smaller": {
      "comment": "Decreases the text size in both panes",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleiner"
          }
        }
      }
    },
    "Swap languages (Cmd+Shift+S)": {
      "comment": "Tooltip of the swap button in the language bar",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachen tauschen (Cmd+Shift+S)"
          }
        }
      }
    },
    "The model returned the text untranslated — try a shorter passage or another model.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell hat den Text unübersetzt zurückgegeben — versuche einen kürzeren Abschnitt oder ein anderes Modell."
          }
        }
      }
    },
    "The server's response could not be read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwort des Servers konnte nicht gelesen werden."
          }
        }
      }
    },
    "Translate": {
      "comment": "Button in the source pane, shown when nothing translates automatically",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzen"
          }
        }
      }
    },
    "Translate now (Cmd+Return)": {
      "comment": "Tooltip of the Translate button",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt übersetzen (Cmd+Return)"
          }
        }
      }
    },
    "Translation": {
      "comment": "Two uses, same word: the placeholder of the read-only result pane, and the title of the Settings tab holding the translation options.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzung"
          }
        }
      }
    },
    "Until Ollama quits": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis Ollama beendet wird"
          }
        }
      }
    },
    "When automatic detection recognizes one of these two languages, the other is selected as the target language.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkennt die automatische Spracherkennung eine dieser beiden Sprachen, wird jeweils die andere als Zielsprache gewählt."
          }
        }
      }
    }
  },
  "version": "1.0"
}
